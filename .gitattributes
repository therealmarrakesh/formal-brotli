# Normalize all text files to LF in the repo and in the working tree
* text=auto eol=lf

*.lean text eol=lf
*.toml text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.yml  text eol=lf
lean-toolchain text eol=lf

# Binary test data (e.g. Brotli-compressed fixtures) must never be converted
*.br  binary
*.bin binary
